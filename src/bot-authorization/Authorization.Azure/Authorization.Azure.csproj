    <ProjectReference Include="../../bot-storage/Storage.Contract/Storage.Contract.csproj" />
    <ProjectReference Include="../Authorization.Api.Contract/Authorization.Api.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GarageGroup.Infra.Endpoint.Core" Version="1.0.0" />
    <PackageReference Include="GarageGroup.Infra.Handler.Core" Version="1.0.0" />
    <PackageReference Include="GarageGroup.Infra.Http.Api.Contract" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="PrimeFuncPack.Dependency.Core" Version="2.1.0" />
  </ItemGroup>

</Project>
